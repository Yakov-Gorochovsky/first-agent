# ============================================================================
# AI Swarm Environment Overrides (.env)
# Base defaults live in config/settings.json. Any variable set here overrides JSON.
# ============================================================================

# --- OPTION 1: Local Ollama (Default — 100% Free & Offline) ---
API_BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL_NAME=qwen3:8b
FAST_THINKING=true

# --- OPTION 2: Free Cloud APIs (Uncomment to switch) ---
# Groq (https://console.groq.com):
# API_BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com):
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash
# Free tiers limit requests per minute: space calls apart and retry patiently.
# LLM_MIN_INTERVAL_SEC=6
# LLM_MAX_RETRIES=8

# --- Budget, Tool & Server Overrides (Optional) ---
MAX_STEPS=8
MAX_SWARM_STEPS=16
MAX_TOTAL_TOKENS=24000
MAX_WALL_SECONDS=180
PYTHON_TIMEOUT_SEC=15
HOST=127.0.0.1
PORT=8000
VERBOSE=true

# Signs mission checkpoints. If unset, a key file is created in workspace/. Set it in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHECKPOINT_HMAC_SECRET=

# Verify HTTPS against the OS certificate store. Use when antivirus inspects HTTPS and web tools report
# CERTIFICATE_VERIFY_FAILED. Never disable certificate verification instead.
# USE_SYSTEM_TRUST_STORE=true
