# ============================================================================
# AI Agent Configuration (.env)
# Pick Option 1 (Local Ollama - default) or Option 2 (Cloud API)
# ============================================================================

# --- OPTION 1: Local Ollama (Free, runs on your machine) ---
LLM_PROVIDER=ollama
API_BASE_URL=http://localhost:11434/v1
API_KEY=ollama
# Installed on your machine: qwen3:8b (native tool calling) and llama3:latest
MODEL_NAME=qwen3:8b

# --- OPTION 2: Free Cloud APIs (Uncomment to use) ---
# Groq (https://console.groq.com):
# API_BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com):
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash

# Agent settings
MAX_STEPS=5
VERBOSE=true
