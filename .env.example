# ============================================================================
# AI Swarm Environment Overrides (.env)
# Base defaults live in config/settings.json. Any variable set here overrides JSON.
# ============================================================================

# --- OPTION 1: Local Ollama (Default — 100% Free & Offline) ---
API_BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL_NAME=qwen3:8b
FAST_THINKING=true

# --- OPTION 2: Free Cloud APIs (Uncomment to switch) ---
# Groq (https://console.groq.com):
# API_BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com):
# API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-2.5-flash

# --- Budget, Tool & Server Overrides (Optional) ---
MAX_STEPS=8
MAX_SWARM_STEPS=16
MAX_TOTAL_TOKENS=24000
MAX_WALL_SECONDS=180
PYTHON_TIMEOUT_SEC=15
HOST=127.0.0.1
PORT=8000
VERBOSE=true
